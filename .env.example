# Copy to .env and fill in. .env is gitignored; never commit real keys.

# --- Provider credentials (server-side only; never exposed to API consumers) ---
SARVAM_API_KEY=
OPENAI_API_KEY=

# --- Storage ---
PSETU_DATABASE_URL=postgresql+psycopg://psetu:psetu@localhost:55432/psetu
PSETU_INPUT_DIR=data/raw
PSETU_OBJECT_STORE_DIR=data/objects
PSETU_COLLECTIONS_RULES_PATH=config/collections.yaml

# --- OCR ---
PSETU_OCR_ENGINE=sarvam
PSETU_OCR_FALLBACK_ENGINE=tesseract
PSETU_OCR_BATCH_PAGES=10
PSETU_RENDER_DPI=300
PSETU_TESSERACT_DATA_DIR=data/tessdata

# --- Logging ---
PSETU_LOG_LEVEL=INFO
PSETU_LOG_JSON=true
