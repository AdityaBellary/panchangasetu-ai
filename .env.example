# Copy to .env and fill in. .env is gitignored; never commit real keys.

# --- Provider credentials (server-side only; never exposed to API consumers) ---
SARVAM_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=            # Google AI Studio key (GOOGLE_API_KEY also works)

# --- LLM chain (tried in order; out-of-credits or outages fall through to the next) ---
# PSETU_LLM_PROVIDERS=["sarvam","gemini","openai"]
# PSETU_GEMINI_CHAT_MODEL=gemini-3.8-flash
# PSETU_ESCALATION_PROVIDER=gemini   # tried when Sarvam cannot give a verified answer; "" turns it off
# PSETU_LLM_DAILY_BUDGET_INR=25

# --- Monitoring ---
# Required for Prometheus (or anything not on this machine) to read /metrics. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
PSETU_API_METRICS_TOKEN=

# --- Storage ---
PSETU_DATABASE_URL=postgresql+psycopg://psetu:psetu@localhost:55432/psetu
PSETU_INPUT_DIR=data/raw
PSETU_OBJECT_STORE_DIR=data/objects
PSETU_COLLECTIONS_RULES_PATH=config/collections.yaml

# --- OCR ---
PSETU_OCR_ENGINE=sarvam
PSETU_OCR_FALLBACK_ENGINE=tesseract
PSETU_OCR_BATCH_PAGES=10
PSETU_RENDER_DPI=300
PSETU_TESSERACT_DATA_DIR=data/tessdata

# --- Logging ---
PSETU_LOG_LEVEL=INFO
PSETU_LOG_JSON=true
