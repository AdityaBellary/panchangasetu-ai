  {
   "id": 1,
   "type": "stat",
   "title": "Questions",
   "description": "Answers in the selected range",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": null,
     "color": {
      "mode": "fixed",
      "fixedColor": "#2a78d6"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "none",
    "graphMode": "area",
    "textMode": "value"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(psetu_answers_total[$__range]))",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
